# Counting, off by default.
#
# With no VITE_ANALYTICS_DOMAIN set, src/analytics.ts makes no network request
# of any kind — which is what happens locally, in the tests and in a fork. Set
# it in Vercel's project settings to turn counting on for the deployed site.
#
# The domain is the site as registered with the analytics provider.
# VITE_ANALYTICS_DOMAIN=longhand-six.vercel.app

# Where the events go. The default is Plausible's hosted event API; any
# endpoint that accepts the same JSON body works, including a self-hosted
# Plausible or Umami.
# VITE_ANALYTICS_HOST=https://plausible.io/api/event
